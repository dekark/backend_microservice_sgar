# Run npm run env:configure to generate the private environment files.
# Add GOOGLE_CLIENT_ID with the real identifier from your Google OAuth application.
# Use the same public Client ID as Angular. The backend only verifies ID tokens.
# No Client Secret is needed for this flow. See GOOGLE-AUTH.md.
# Until then, Google login remains disabled.
AUTH_GOOGLE_ENABLED=false
# AUTH_DEFAULT_ROLE_ID is optional: set an existing active role ID to enable registration.
# When absent, only already registered users can sign in.
# DATABASE_URL is read from database/.env by all Nest services.
# LOCAL_JWT_SECRET and LOCAL_RABBIT_PASSWORD are generated in .env.auth-local.
# Existing secrets are preserved. Do not commit the private file.
AUTH_HTTP_PORT=3000
AUDIT_HTTP_PORT=3006
RABBIT_HTTP_PORT=15673
RABBIT_AMQP_PORT=5673
KAFKA_HOST_PORT=19092
FRONTEND_ORIGIN=http://localhost:4200

# ====================================================================
# ALMACENAMIENTO DE ARCHIVOS / IMAGENES (AWS S3) - OPCIONAL
# ====================================================================
# S3_MEDIA_BUCKET=proyecto-capstone
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<tu-aws-access-key-id>
# AWS_SECRET_ACCESS_KEY=<tu-aws-secret-access-key>
# AWS_SESSION_TOKEN=<tu-aws-session-token>
# S3_ENDPOINT=http://s3:9000
# ====================================================================

# ====================================================================
# BROKERS EN AWS (KAFKA / RABBITMQ) - OPCIONAL PARA AMBIENTE AWS
# ====================================================================
# AWS MSK (Managed Streaming for Kafka):
# KAFKA_BROKERS=b-1.xxx.kafka.us-east-1.amazonaws.com:9096,b-2.xxx.kafka.us-east-1.amazonaws.com:9096
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=<tu-msk-username>
# KAFKA_SASL_PASSWORD=<tu-msk-password>
#
# Amazon MQ (RabbitMQ en AWS):
# RABBITMQ_URL=amqps://<user>:<password>@b-xxxx.mq.us-east-1.amazonaws.com:5671
# ====================================================================

