# Puerto HTTP de roles-service. Copia este archivo a .env para cambiarlo.
PORT=3001
AUTH_SERVICE_URL=http://localhost:3000
# DATABASE_URL se carga desde ../database/.env.

# Application audit: capture always remains enabled; this flag controls delivery.
APPLICATION_EVENTS_ENABLED=true
APPLICATION_OUTBOX_INTERVAL_MS=1000
APPLICATION_KAFKA_TOPIC=application.events.v1
AUTH_AUDIT_QUEUE=audit_queue
KAFKA_BROKER=localhost:19092
# AWS: KAFKA_BROKERS supports comma-separated endpoints; KAFKA_SSL=true enables TLS.
# Optional SASL: KAFKA_SASL_MECHANISM, KAFKA_SASL_USERNAME, KAFKA_SASL_PASSWORD.
# RabbitMQ supports amqps:// through RABBITMQ_URL. Keep credentials in private env/secrets.

# Incoming controller commands through both shared brokers.
BROKER_RPC_ENABLED=true
BROKER_RPC_TIMEOUT_MS=30000
AUTH_RPC_TRANSPORT=rabbit

# ====================================================================
# ALMACENAMIENTO DE ARCHIVOS / IMAGENES (AWS S3) - OPCIONAL
# ====================================================================
# S3_MEDIA_BUCKET=proyecto-capstone
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<tu-aws-access-key-id>
# AWS_SECRET_ACCESS_KEY=<tu-aws-secret-access-key>
# AWS_SESSION_TOKEN=<tu-aws-session-token>
# S3_ENDPOINT=http://localhost:9000
# ====================================================================

# ====================================================================
# BROKERS EN AWS (KAFKA / RABBITMQ) - OPCIONAL PARA AMBIENTE AWS
# ====================================================================
# AWS MSK (Managed Streaming for Kafka):
# KAFKA_BROKERS=b-1.xxx.kafka.us-east-1.amazonaws.com:9096,b-2.xxx.kafka.us-east-1.amazonaws.com:9096
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=<tu-msk-username>
# KAFKA_SASL_PASSWORD=<tu-msk-password>
#
# Amazon MQ (RabbitMQ en AWS):
# RABBITMQ_URL=amqps://<user>:<password>@b-xxxx.mq.us-east-1.amazonaws.com:5671
# ====================================================================

